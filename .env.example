# Copy to .env and adjust (`python scripts/manage.py setup` does this for you).
# Every setting is in src/copilot/config.py (prefix COPILOT_).

# Where the web UI listens. 0.0.0.0 = all network interfaces (reachable from other machines on
# your network, if the firewall allows it). 127.0.0.1 = this machine only. You can also use one
# specific IP address of this machine, e.g. 192.168.1.20.
COPILOT_HOST=0.0.0.0
COPILOT_PORT=8000

# Run the LLM on an NVIDIA GPU with Docker (see docs/install-*.md for prerequisites).
COPILOT_GPU=false

COPILOT_JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-bytes

# POST /auth/dev-token lets ANYONE who can reach the server mint a token for any role. The demo
# shell scripts (scripts/demo) need it; turn it on only while COPILOT_HOST is 127.0.0.1.
COPILOT_DEV_TOKEN_ENDPOINT=false

# Web UI accounts (SQLite). On first start with an empty database, alice (employee), bob (manager)
# and carol (admin) are created with COPILOT_DEMO_PASSWORD and must change it at first login.
# Changing COPILOT_DEMO_PASSWORD later updates demo accounts that haven't signed in yet (run
# `manage.py up` again to apply it); accounts that already chose their own password keep it.
# COPILOT_USERS_DB=data/users.db
COPILOT_SEED_DEMO_USERS=true
COPILOT_DEMO_PASSWORD=ChangeMe123

COPILOT_OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
COPILOT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
COPILOT_RERANKER_MODEL=BAAI/bge-reranker-base
COPILOT_RETRIEVAL_MODE=hybrid_rerank
COPILOT_TOP_K=6

# Offline mode for development without Docker services or model downloads:
# COPILOT_EMBEDDER=hash
# COPILOT_RERANKER=none
# COPILOT_VECTOR_STORE=memory
# COPILOT_CACHE=memory
# COPILOT_LLM=echo
