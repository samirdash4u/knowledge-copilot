# Copy to .env and adjust. Every setting is in src/copilot/config.py (prefix COPILOT_).
COPILOT_JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-bytes
COPILOT_DEV_TOKEN_ENDPOINT=true

COPILOT_OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
COPILOT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
COPILOT_RERANKER_MODEL=BAAI/bge-reranker-base
COPILOT_RETRIEVAL_MODE=hybrid_rerank
COPILOT_TOP_K=6

# Offline mode for development without Docker services or model downloads:
# COPILOT_EMBEDDER=hash
# COPILOT_RERANKER=none
# COPILOT_VECTOR_STORE=memory
# COPILOT_CACHE=memory
# COPILOT_LLM=echo
